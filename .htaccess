Options -Indexes

# Protection des dossiers et fichiers sensibles
RewriteEngine On
RewriteRule ^\.env - [F,L,NC]
RewriteRule ^api/lib/ - [F,L,NC]
RewriteRule ^api/migrate\.php - [F,L,NC]
RewriteRule ^scripts/ - [F,L,NC]
RewriteRule ^templates/ - [F,L,NC]
RewriteRule ^lang/ - [F,L,NC]
RewriteRule \.sqlite$ - [F,L,NC]
RewriteRule ^src/ - [F,L,NC]
RewriteRule ^node_modules/ - [F,L,NC]
RewriteRule ^design-reference/ - [F,L,NC]
RewriteRule ^package\.json$ - [F,L,NC]
RewriteRule ^package-lock\.json$ - [F,L,NC]
RewriteRule ^tailwind\.config\.js$ - [F,L,NC]
RewriteRule \.md$ - [F,L,NC]
RewriteRule ^cookies\.txt$ - [F,L,NC]
RewriteRule ^\.git/ - [F,L,NC]
RewriteRule ^\.agent/ - [F,L,NC]
RewriteRule ^docs/ - [F,L,NC]
RewriteRule \.(zip|sql|bak|log)$ - [F,L,NC]

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set Content-Security-Policy "default-src 'self'; connect-src 'self' https://*.hereapi.com https://nominatim.openstreetmap.org; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org https://pava-shipping.fr;"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Routage localisé (/fr/, /en/, /de/, /nl/)
RewriteRule ^(fr|en|de|nl)/?$ index.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/track/?$ track.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/contact/?$ contact.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/login/?$ login.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/logout/?$ logout.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/dashboard/?$ dashboard.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/shipments/?$ shipments.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/shipments/new/?$ shipment_new.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/shipments/([0-9]+)/?$ shipment.php?id=$2&lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/customers/?$ customers.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/services/?$ services.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/services/expedition/?$ service_expedition.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/services/suivi/?$ service_suivi.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/services/livraison/?$ service_livraison.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/services/gestion/?$ service_gestion.php?lang=$1 [QSA,L]
RewriteRule ^(fr|en|de|nl)/services/gestion-expeditions/?$ service_gestion.php?lang=$1 [QSA,L]

# Routage explicite standard
RewriteRule ^$ index.php [L]
RewriteRule ^track$ track.php [L]
RewriteRule ^contact$ contact.php [L]
RewriteRule ^login$ login.php [L]
RewriteRule ^logout$ logout.php [L]
RewriteRule ^dashboard$ dashboard.php [L]
RewriteRule ^shipments$ shipments.php [L]
RewriteRule ^shipments/new$ shipment_new.php [L]
RewriteRule ^shipments/([0-9]+)$ shipment.php?id=$1 [QSA,L]
RewriteRule ^customers$ customers.php [L]
RewriteRule ^services/?$ services.php [L]
RewriteRule ^services/expedition/?$ service_expedition.php [L]
RewriteRule ^services/suivi/?$ service_suivi.php [L]
RewriteRule ^services/livraison/?$ service_livraison.php [L]
RewriteRule ^services/gestion/?$ service_gestion.php [L]
RewriteRule ^services/gestion-expeditions/?$ service_gestion.php [L]
ErrorDocument 404 /404.php
